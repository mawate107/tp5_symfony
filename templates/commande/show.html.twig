{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.numero }}{% endblock %}

{% block body %}
    <h1>Commande {{ commande.numero }}</h1>

    {% for message in app.flashes('success') %}
        <p style="color:green">{{ message }}</p>
    {% endfor %}

    <table class="table">
        <tbody>
            <tr>
                <th>Numéro</th>
                <td>{{ commande.numero }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ commande.date ? commande.date|date('d/m/Y H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ commande.statut }}</td>
            </tr>
            <tr>
                <th>Client</th>
                <td>
                    {% if commande.client %}
                        <a href="{{ path('app_client_show', {'id': commande.client.id}) }}">{{ commande.client.prenom }} {{ commande.client.nom }}</a>
                        ({{ commande.client.email }})
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <h2>Produits commandés</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Prix unitaire</th>
                <th>Quantité</th>
                <th>Montant</th>
            </tr>
        </thead>
        <tbody>
        {% for ligne in commande.ligneCommandes %}
            <tr>
                <td>
                    {% if ligne.produit %}
                        <a href="{{ path('app_produit_show', {'id': ligne.produit.id}) }}">{{ ligne.produit.nom }}</a>
                    {% endif %}
                </td>
                <td>{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                <td>{{ ligne.quantite }}</td>
                <td>{{ ligne.montant|number_format(2, ',', ' ') }} €</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucune ligne</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total</th>
                <th>{{ commande.total|number_format(2, ',', ' ') }} €</th>
            </tr>
        </tfoot>
    </table>

    <a href="{{ path('app_commande_index') }}">Retour à la liste</a>
{% endblock %}
